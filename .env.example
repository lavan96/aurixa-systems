# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Aurixa Systems storefront backend (Supabase project moeyytuduycrvvncdtme) ──
# The browser talks to THIS site's own backend. billing.ts + leads.ts resolve
# the functions base in this order: VITE_STOREFRONT_API_URL, else
# {VITE_SUPABASE_URL}/functions/v1, else the known production project.
VITE_SUPABASE_URL="https://moeyytuduycrvvncdtme.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"
# Optional explicit override of the storefront functions base URL:
# VITE_STOREFRONT_API_URL="https://moeyytuduycrvvncdtme.supabase.co/functions/v1"

# ── Stage 2 questionnaire access ────────────────────────────────────────────
# VITE_QUESTIONNAIRE_OPEN_ACCESS: when "true", /questionnaire renders for anyone
# with the URL. Leave UNSET in production — access should come from the Stage 1
# handoff session or a secure questionnaire link. Useful for stakeholder review.
# VITE_QUESTIONNAIRE_OPEN_ACCESS="true"

# VITE_READINESS_API_URL: Stage 2 questionnaire service endpoint. Defaults to
# {storefront functions base}/readiness-questionnaire. The browser only ever
# sends an opaque questionnaire token or session token here — no privileged key.
# VITE_READINESS_API_URL="https://moeyytuduycrvvncdtme.supabase.co/functions/v1/readiness-questionnaire"

# ── Stage 3 strategic review scheduling ─────────────────────────────────────
# By default /schedule-strategic-review renders the built-in scheduler: a live
# date/time picker driven by the review window in src/lib/reviewAvailability.ts
# (Mon–Fri, 09:00–16:30 Australia/Sydney, 30-minute sessions, 24 hours' notice,
# 45-day horizon). Requested times are POSTed to {storefront base}/capture-lead.
#
# VITE_BOOKINGS_URL: set this ONLY to hand scheduling over to a Microsoft
# Bookings page — it replaces the built-in scheduler with that embed. It must
# be HTTPS and served from a Microsoft Bookings host (outlook.office.com,
# outlook.office365.com, outlook.live.com, bookings.microsoft.com, book.ms) —
# see BOOKING_HOST_ALLOWLIST in src/lib/strategicReviewBooking.ts. Anything
# else is ignored and the scheduler stays. Applicant name/email are appended
# as prefill when the tab still holds the Stage 1 handoff.
# VITE_BOOKINGS_URL="https://outlook.office365.com/owa/calendar/aurixa@aurixasystems.com.au/bookings/"

# Stage 3 booking requests go to the "Aurixa Waitlist Stage 3" Make scenario,
# whose webhook is a constant in src/lib/reviewBookingClient.ts (the same
# arrangement as the Stage 2 questionnaire webhook). capture-lead and Mission
# Control still receive the same payload, mirrored fire-and-forget afterwards,
# so neither can change what the applicant is told. Nothing to configure here.

# VITE_MISSION_CONTROL_URL: Mission Control origin. The storefront backend
# forwards checkout/handoff/identity/session here (MC stays the billing engine +
# Stripe); leads.ts also mirrors leads to MC's operator console. The storefront
# edge functions themselves default MISSION_CONTROL_URL to this same origin.
VITE_MISSION_CONTROL_URL="https://mission-control.aurixasystems.com.au"
